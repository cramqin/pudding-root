<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#0E0E10">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Xiaomi 17 Global (pudding) · HyperOS 4 temp root"
            android:textColor="#9AA0A6"
            android:textSize="13sp"
            android:paddingBottom="16dp" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1B1B1F"
            android:padding="14dp"
            android:textColor="#E8EAED"
            android:textSize="13sp"
            android:fontFamily="monospace" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="KernelSU manager package"
            android:textColor="#9AA0A6"
            android:textSize="13sp"
            android:paddingTop="16dp"
            android:paddingBottom="6dp" />

        <EditText
            android:id="@+id/pkg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1B1B1F"
            android:padding="14dp"
            android:textColor="#E8EAED"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:inputType="textNoSuggestions"
            android:hint="me.weishu.kernelsu"
            android:textColorHint="#5F6368"
            android:autofillHints="" />

        <Button
            android:id="@+id/root"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Root (KernelSU)"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#2F6FEB"
            android:textColor="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Log"
            android:textColor="#9AA0A6"
            android:textSize="13sp"
            android:paddingTop="20dp"
            android:paddingBottom="6dp" />

        <TextView
            android:id="@+id/log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="220dp"
            android:background="#121216"
            android:padding="12dp"
            android:textColor="#B9F6CA"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:textIsSelectable="true" />
    </LinearLayout>
</ScrollView>
