<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#0D1015">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="22dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="Pudding Root"
                android:src="@drawable/ic_launcher" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pudding Root"
                    android:textColor="#FFF7E8"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="A one-tap root bridge for Xiaomi 17"
                    android:textColor="#9BA5B4"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="DEVICE CHECK"
            android:textColor="#F3BE62"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card"
            android:fontFamily="sans"
            android:lineSpacingExtra="3dp"
            android:padding="16dp"
            android:textColor="#E8EDF4"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="ROOT MANAGER"
            android:textColor="#F3BE62"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Choose your installed manager. Custom lets you enter a spoofed package name."
            android:textColor="#8994A4"
            android:textSize="12sp" />

        <Spinner
            android:id="@+id/manager_spinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="9dp"
            android:background="@drawable/bg_input" />

        <EditText
            android:id="@+id/pkg"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="9dp"
            android:background="@drawable/bg_input"
            android:fontFamily="monospace"
            android:hint="me.weishu.kernelsu"
            android:inputType="textNoSuggestions"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="#F2F5F8"
            android:textColorHint="#657081"
            android:textSize="13sp" />

        <Button
            android:id="@+id/shizuku"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#293240"
            android:text="REQUEST SHIZUKU ACCESS"
            android:textAllCaps="false"
            android:textColor="#E8EDF4"
            android:textSize="13sp" />

        <Button
            android:id="@+id/root"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_button"
            android:text="ROOT THIS BOOT"
            android:textAllCaps="false"
            android:textColor="#2C2418"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/copy_log"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:backgroundTint="#293240"
                android:text="COPY LOG"
                android:textAllCaps="false"
                android:textColor="#E8EDF4"
                android:textSize="11sp" />

            <Button
                android:id="@+id/reboot"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:backgroundTint="#293240"
                android:tooltipText="Power off, wait ~2 minutes, then turn on for the best success rate."
                android:text="REBOOT"
                android:textAllCaps="false"
                android:textColor="#E8EDF4"
                android:textSize="11sp" />

            <Button
                android:id="@+id/soft_boot"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:backgroundTint="#293240"
                android:tooltipText="Restart the Android framework without losing the loaded KernelSU module."
                android:text="SOFT BOOT"
                android:textAllCaps="false"
                android:textColor="#E8EDF4"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="Tip: a cold boot helps — power off ~2 min, then turn on, for the best success rate."
            android:textColor="#8F9AA8"
            android:textSize="11sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="Requires Shizuku • reboot and retry after a failed reclaim"
            android:textColor="#6F7A89"
            android:textSize="11sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="RUN LOG"
            android:textColor="#F3BE62"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="190dp"
            android:background="@drawable/bg_card"
            android:fontFamily="monospace"
            android:padding="14dp"
            android:textColor="#B9F6CA"
            android:textIsSelectable="true"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
